# Backend variable names only. Inject secret values from the deployment secret
# manager; never copy backend credentials into the Android .env file.
NODE_ENV=production
PORT=3000
JWT_SECRET=
JWT_ISSUER=https://identity.example.com
JWT_AUDIENCE=fitplan-backend
JWT_ALGORITHMS=HS256
JWT_TTL_SECONDS=900
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
CORS_ALLOWED_ORIGINS=https://app.example.com
TRUST_PROXY_HOPS=1
DATABASE_URL=
DATABASE_TLS=verify_identity
RATE_LIMIT_STORE=mysql
GOOGLE_OAUTH_CLIENT_ID=
