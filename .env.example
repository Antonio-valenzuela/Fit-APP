GOOGLE_WEB_CLIENT_ID=MY_GOOGLE_WEB_CLIENT_ID
PREMIUM_SUBSCRIPTION_ID=fitplan_premium_monthly

# Backend Proxy Configuration
PORT=3000
BACKEND_API_KEY=YOUR_BACKEND_API_KEY_HERE
GEMINI_TIMEOUT_MS=60000

# URL publica HTTPS del backend para pruebas en exterior y datos moviles:
BACKEND_BASE_URL=https://your-public-backend.example.com

# Para pruebas locales/emulador, puedes usar en su lugar:
# BACKEND_BASE_URL=http://10.0.2.2:3000
